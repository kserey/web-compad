---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

// Si estamos en el home usamos anclas directas (#section), si estamos en otra página usamos /#section
const getHref = (hash: string) => isHome ? hash : `/${hash}`;
---

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
  <div class="container">
    <a class="navbar-brand" href={getHref("#home")}>
      <img src="/IMG/logos/compad.png" alt="Compad" height="40" />
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href={getHref("#about-us")}>Nosotros</a></li>
        <li class="nav-item"><a class="nav-link" href="/ciberseguridad">Ciberseguridad</a></li>
        <li class="nav-item"><a class="nav-link" href={getHref("#services")}>Servicios</a></li>
        <li class="nav-item"><a class="nav-link" href={getHref("#cases")}>Casos</a></li>
        <li class="nav-item"><a class="nav-link" href={getHref("#partners")}>Partners</a></li>
        <li class="nav-item"><a class="nav-link" href={getHref("#contact")}>Contacto</a></li>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Cierre automático del menú móvil al hacer clic en un enlace
  const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
  const navbarCollapse = document.querySelector('.navbar-collapse');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (navbarCollapse && navbarCollapse.classList.contains('show')) {
        // @ts-ignore
        new bootstrap.Collapse(navbarCollapse, { toggle: false }).hide();
      }
    });
  });
</script>